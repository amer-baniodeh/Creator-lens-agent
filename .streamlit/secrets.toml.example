# Copy this to secrets.toml (locally) or paste into Streamlit Cloud's Secrets panel.
# secrets.toml is gitignored — never commit it.

OPENAI_API_KEY = "sk-..."
PINECONE_API_KEY = "pcsk_..."
LANGCHAIN_API_KEY = "lsv2_pt_..."
PINECONE_INDEX_NAME = "copilot-mvp"
PINECONE_ENVIRONMENT = "us-east-1"
OPENAI_LLM_MODEL = "gpt-4o-mini"
OPENAI_EMBEDDING_MODEL = "text-embedding-3-small"
LANGCHAIN_TRACING_V2 = "true"
LANGCHAIN_PROJECT = "copilot-mvp"

# YouTube proxy (required on Streamlit Cloud — YouTube blocks cloud IPs).
# Fill ONE of the two options below.
# Option A — Webshare residential proxies (https://www.webshare.io/):
WEBSHARE_PROXY_USERNAME = ""
WEBSHARE_PROXY_PASSWORD = ""
# Option B — any HTTP(S) proxy URL:
YT_HTTP_PROXY = ""
YT_HTTPS_PROXY = ""
