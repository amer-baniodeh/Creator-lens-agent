# ── OpenAI ────────────────────────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Pinecone ──────────────────────────────────────────────────────────────────
# Get from: https://app.pinecone.io → API Keys
PINECONE_API_KEY=pcsk_...
# Your index name — must match what you created in the Pinecone console
PINECONE_INDEX_NAME=copilot-mvp
# Region you selected when creating the index
PINECONE_ENVIRONMENT=us-east-1

# ── LangSmith ─────────────────────────────────────────────────────────────────
# Get from: https://smith.langchain.com → Settings → API Keys
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=copilot-mvp
# Set to false to disable tracing locally
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Model config ──────────────────────────────────────────────────────────────
# LLM used by the agent and RAG chain
OPENAI_LLM_MODEL=gpt-4o-mini
# Embedding model — dimension MUST match your Pinecone index (1536)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Chunking config ───────────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# Number of chunks returned per similarity search
TOP_K_RESULTS=5

# ── YouTube proxy (needed on cloud IPs — YouTube blocks AWS/GCP/Azure) ──────
# Local dev: leave blank. Cloud deploy: fill ONE of the two options below.
#
# Option A — Webshare rotating residential proxies (recommended, cheap paid tier).
# Sign up at https://www.webshare.io/ → buy a "residential" plan → copy creds.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
#
# Option B — any generic HTTP(S) proxy URL, e.g. http://user:pass@host:port
YT_HTTP_PROXY=
YT_HTTPS_PROXY=
